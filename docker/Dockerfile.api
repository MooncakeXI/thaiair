FROM python:3.13-slim AS builder

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

WORKDIR /build
COPY pyproject.toml ./
COPY src/ ./src/

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install ".[serving]"

FROM python:3.13-slim

RUN useradd --create-home --uid 1000 app

COPY --from=builder --chown=app:app /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PORT=8000

WORKDIR /home/app
COPY --chown=app:app data/raw/observations.parquet data/raw/observations.parquet
COPY --chown=app:app models/pm25.joblib models/pm25.joblib

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
    CMD python -c "import os, urllib.request; urllib.request.urlopen(f'http://localhost:{os.environ[\"PORT\"]}/health')" || exit 1

CMD ["sh", "-c", "exec uvicorn thaiair.api.app:app --host 0.0.0.0 --port ${PORT}"]
